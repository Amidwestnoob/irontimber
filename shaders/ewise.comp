// mode 0: o = a + b ; 1: o = silu(a) * b ; 2: o = a. wg.y = token.
layout(local_size_x = 256) in;
void main() {
    uint mode = pc.u[0], n = pc.u[1], ao = pc.u[3], as_ = pc.u[4], bo = pc.u[5], bs = pc.u[6], oo = pc.u[7], os = pc.u[8];
    uint i = gl_GlobalInvocationID.x, t = gl_WorkGroupID.y;
    if (i >= n) return;
    float x = a[ao + t * as_ + i];
    float r;
    if (mode == 0u) r = x + a[bo + t * bs + i];
    else if (mode == 1u) r = silu(x) * a[bo + t * bs + i];
    else r = x;
    a[oo + t * os + i] = r;
}
